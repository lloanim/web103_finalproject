# Copy to backend/.env and edit
DATABASE_URL=postgres://localhost:5432/prepwise_dev
PORT=3001

# Optional: AI Chef chat (Google Gemini). The chat returns 503 without a key.
GEMINI_API_KEY=
# GEMINI_MODEL=

# Optional: reset the local prepwise_test database to its seed data.
#   npm run reset    -> needs TEST_DATABASE_URL
#   POST /api/reset  -> needs TEST_DATABASE_URL and ENABLE_TEST_RESET=true (local requests only)
# The database name must be prepwise_test.
# ENABLE_TEST_RESET=true
# TEST_DATABASE_URL=postgres://localhost:5432/prepwise_test
